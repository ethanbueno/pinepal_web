# Copy to .env and fill in. .env is git-ignored.

# Aiven MySQL (values from the service's "Connection information" panel)
DB_HOST=<host from the service>
DB_PORT=<port from the service>
DB_NAME=pinepal_db

# Two database logins (least privilege). Ask the team for the passwords.
# The app: it can only read and write rows, and only add to audit_logs (create_app_user.py).
DB_USER=pinepal_app
DB_PASSWORD=
# The admin login, only for setup_db.py and the migrate_*.py scripts (tables and triggers).
DB_ADMIN_USER=avnadmin
DB_ADMIN_PASSWORD=

# CA certificate downloaded from Aiven, relative to this folder
DB_SSL_CA=ca.pem

# Local XAMPP instead: DB_HOST=localhost, DB_PORT=3306, DB_USER=root, leave DB_SSL_CA and
# DB_ADMIN_* out (or run create_app_user.py to get a limited app login there too)

JWT_SECRET_KEY=
# Encrypts stored IP addresses and backups (encryption.py). Everyone running the backend needs
# the SAME key: ask the team, or make the first one with: python encryption.py
DATA_ENCRYPTION_KEY=
ADMIN_PASSWORD=

# Gmail that sends Forgot password codes (mailer.py). Use an "app password", not the account's
# real password: turn on 2-Step Verification, then make one at myaccount.google.com/apppasswords.
# Left empty, a local "python app.py" prints the code in the terminal instead of emailing it.
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=PinePal

# Where scan photos are stored (photo_storage.py). Set it, and photos go to Cloudinary so every
# computer and the Render server can show them. Empty, they stay in backend/uploads on this
# computer only. Looks like cloudinary://<api_key>:<api_secret>@<cloud_name>. Ask the team.
CLOUDINARY_URL=
