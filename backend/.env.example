# Copy to .env and fill in. .env is git-ignored.

# Aiven MySQL (values from the service's "Connection information" panel)
DB_HOST=mysql-xxxxxxx-yourproject.d.aivencloud.com
DB_PORT=22261
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=pinepal_db
# CA certificate downloaded from Aiven, relative to this folder
DB_SSL_CA=ca.pem

# Local XAMPP instead: DB_HOST=localhost, DB_PORT=3306, DB_USER=root, and leave DB_SSL_CA out

JWT_SECRET_KEY=
ADMIN_PASSWORD=
